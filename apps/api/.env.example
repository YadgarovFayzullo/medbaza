# --- Database -------------------------------------------------------------
# Host-run API against Dockerised Postgres:
DATABASE_URL=postgresql+asyncpg://medsupply:medsupply@localhost:5432/medsupply
# When the API itself runs inside Compose, use the service hostname instead:
# DATABASE_URL=postgresql+asyncpg://medsupply:medsupply@db:5432/medsupply

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- App ------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# --- Background jobs ------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Sensitive document storage ------------------------------------------
# Fernet key for prescription-at-rest encryption.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PRESCRIPTION_ENCRYPTION_KEY=
STORAGE_BUCKET=medbaza-local
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
PRESIGNED_URL_TTL_SECONDS=300

# --- Payments -------------------------------------------------------------
# CLAUDE.md section 4 is an OPEN decision: 'fake' is the only implementation
# that exists. Do not point this at a real PSP.
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=change-me-in-production
# Platform commission in basis points (800 = 8%).
PLATFORM_FEE_BPS=800

# --- Frontend -------------------------------------------------------------
WEB_BASE_URL=http://localhost:3000

# --- Email ----------------------------------------------------------------
EMAIL_API_KEY=
EMAIL_FROM=orders@medbaza.example

# --- Observability --------------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=
