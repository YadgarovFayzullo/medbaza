# Base URL of the MedBaza API. Public because Server Components and the browser
# both call it; nothing secret ever lives in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shared secret for POST /api/revalidate, which busts the storefront's ISR
# cache tags after a catalog change. Generate with: openssl rand -hex 24
REVALIDATE_SECRET=dev-only-change-me

# Serve a frozen snapshot of the catalog instead of calling the API.
# For the window where the storefront is deployed but the API is not hosted
# anywhere: browsing works, and cart, sign-in and checkout still need a real
# API. Anything other than "true" leaves it off.
NEXT_PUBLIC_DEMO_CATALOG=false
