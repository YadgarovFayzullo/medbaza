# Production build defaults. Committed on purpose: these are public values, and
# nothing secret may ever live in a NEXT_PUBLIC_ variable.

# Serve the frozen catalog snapshot instead of calling the API.
#
# On because the storefront is deployed and the API is not hosted anywhere yet,
# so every catalog read would fail and the site would render empty. Browsing
# works; cart, sign-in and checkout still need a real API and still fail.
#
# Turn this to false — and delete lib/api-client/demo-catalog.ts with the
# branches in endpoints.ts — the moment the API has a public URL.
NEXT_PUBLIC_DEMO_CATALOG=true
